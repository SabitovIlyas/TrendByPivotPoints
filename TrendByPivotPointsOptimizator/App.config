<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
    <runtime>
        <!-- Серверная сборка мусора: своя куча и свой поток сборки на каждое ядро.
             Расчёт хромосом идёт в несколько потоков и активно выделяет память
             (ряды индикаторов, ордера, сделки на каждый бар), а сборщик по
             умолчанию работает с одной общей кучей и на время сборки
             останавливает все потоки — из-за этого параллельный прогон упирался
             в сборку мусора, а не в процессор. -->
        <gcServer enabled="true"/>
    </runtime>
</configuration>
